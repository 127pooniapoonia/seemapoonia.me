---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
  data-scrolled="false"
>
  <!-- Scroll progress -->
  <div id="scroll-progress" class="absolute top-0 left-0 h-0.5 bg-brand origin-left scale-x-0 w-full" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="#home" class="flex items-center gap-3 group" aria-label="Seema Poonia — home">
      <span class="w-9 h-9 rounded-lg bg-brand text-white font-extrabold text-sm flex items-center justify-center transition-transform duration-300 group-hover:rotate-6">
        SP
      </span>
      <span class="header-text font-bold text-white tracking-tight transition-colors">Seema Poonia</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="nav-link header-text relative text-sm font-medium text-white/80 hover:text-brand transition-colors duration-200 after:absolute after:left-0 after:-bottom-1.5 after:h-0.5 after:w-full after:bg-brand after:scale-x-0 after:origin-left after:transition-transform hover:after:scale-x-100"
        >
          {label}
        </a>
      ))}
      <a href="/Seema_Poonia_Resume.pdf" download class="btn-primary !px-4 !py-2 !text-xs">
        Download CV
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      class="header-text md:hidden p-2 text-white hover:text-brand transition-colors"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <svg id="icon-menu" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg">
    <nav class="flex flex-col py-4 px-6 gap-1" aria-label="Mobile navigation">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="mobile-nav-link text-sm font-medium text-gray-700 hover:text-brand transition-colors duration-200 py-2.5"
        >
          {label}
        </a>
      ))}
      <a href="/Seema_Poonia_Resume.pdf" download class="btn-primary justify-center mt-2">Download CV</a>
    </nav>
  </div>
</header>

<style>
  /* Once scrolled past the dark hero, switch to a light frosted bar */
  #site-header[data-scrolled='true'] {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(16, 24, 40, 0.08);
  }
  #site-header[data-scrolled='true'] .header-text {
    color: #111827;
  }
  #site-header[data-scrolled='true'] .nav-link {
    color: #4b5563;
  }
  #site-header[data-scrolled='true'] .nav-link:hover,
  #site-header[data-scrolled='true'] .nav-link.active {
    color: #ff7043;
  }
  .nav-link.active::after {
    transform: scaleX(1);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const progress = document.getElementById('scroll-progress')!;
  const toggle = document.getElementById('nav-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  // Header style + progress bar on scroll
  const onScroll = () => {
    header.dataset.scrolled = String(window.scrollY > 60);
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Hamburger toggle
  toggle.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    iconMenu.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    header.dataset.scrolled = String(!isOpen || window.scrollY > 60);
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    });
  });

  // Active nav link via IntersectionObserver
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`);
          });
        }
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  sections.forEach((s) => observer.observe(s));
</script>
