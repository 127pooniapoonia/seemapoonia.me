---
const stats = [
  { value: 8, suffix: '', unit: 'Years', label: 'building for the web' },
  { value: 7, suffix: '', unit: 'Engineers', label: 'led as Team Lead' },
  { value: 6, suffix: '', unit: 'Products', label: 'architected & launched' },
  { value: 20, suffix: '+', unit: 'Partners', label: 'onboarded on a white-label platform' },
];
---

<section id="impact" class="relative z-20 -mt-14 bg-[linear-gradient(to_bottom,transparent_56px,#f6f7f9_56px)]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="card grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-gray-100">
      {stats.map((stat, i) => (
        <div class="reveal p-6 md:p-8 text-center" style={`--d: ${i * 100}ms`}>
          <div class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900">
            <span data-count={stat.value} data-decimals={stat.decimals ?? 0}>0</span><span class="text-brand">{stat.suffix}</span>
          </div>
          <div class="text-xs font-bold uppercase tracking-widest text-brand mt-2">{stat.unit}</div>
          <div class="text-sm text-gray-500 mt-1">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
