---
import SectionLabel from './SectionLabel.astro';
import { skillGroups } from '../data/skills';

const highlights = [
  { title: 'Promoted twice', text: 'Frontend Developer → Senior (2021) → Team Lead (2024) at one company.' },
  { title: 'Architect to lead', text: 'Six products architected and launched, then led as the team took them forward.' },
  { title: 'Frontend-led full-stack', text: 'Shaped serverless and event-driven backend services with backend engineers.' },
];
---

<section id="about" class="py-24 md:py-32 bg-surface">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-14 items-start">
      <!-- Story -->
      <div class="reveal">
        <SectionLabel number="01" label="About" />
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 mb-8 leading-tight">
          I build the products, the team <span class="text-gradient">and the process</span> that ship them.
        </h2>
        <div class="space-y-5 text-gray-600 leading-relaxed">
          <p>
            I'm a <strong class="text-gray-900">Engineering Team Lead</strong> with 8 years of
            experience, 7 of them at Electrum, where I own the company's entire frontend ecosystem — from
            consumer-facing home-energy marketplaces to internal operations platforms. I care deeply about
            performance, accessibility and interfaces that earn user trust.
          </p>
          <p>
            I joined as a Frontend Developer, was promoted to Senior in 2021 and to Team Lead in 2024,
            and now <strong class="text-gray-900">lead a cross-functional team of 7</strong> (frontend, backend, QA):
            sprint planning, estimation, PR-review standards, tech interviews and onboarding. I'm the person
            leadership calls when there's a new problem statement and no existing playbook.
          </p>
          <p>
            I'm open to Team Lead and Engineering Lead roles in Hyderabad or remote, and I'm an
            <strong class="text-gray-900">immediate joiner</strong>.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 mt-8">
          <a href="/Seema_Poonia_Resume.pdf" download class="btn-primary">
            Download Resume <span class="arrow" aria-hidden="true">↓</span>
          </a>
          <a href="#contact" class="btn-outline">
            Get in touch <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Highlights -->
      <div class="space-y-4 lg:pt-12">
        {highlights.map((item, i) => (
          <div class="reveal card card-hover p-6 flex gap-4" style={`--d: ${i * 120}ms`}>
            <span class="shrink-0 w-10 h-10 rounded-xl bg-brand-soft text-brand font-extrabold flex items-center justify-center">
              0{i + 1}
            </span>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">{item.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Skills -->
    <div class="mt-24">
      <h3 class="reveal text-2xl font-extrabold tracking-tight text-gray-900 mb-8">Skills</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {skillGroups.map((group, i) => (
          <div class="reveal card card-hover p-6" style={`--d: ${i * 100}ms`}>
            <h4 class="text-xs font-bold uppercase tracking-widest text-brand mb-4">
              {group.name}
            </h4>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="chip">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
