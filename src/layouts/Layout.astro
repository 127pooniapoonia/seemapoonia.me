---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Seema Poonia — Senior Software Engineer & Team Lead | React · Angular · TypeScript',
  description = 'Senior Software Engineer (frontend-led full-stack) and Team Lead with 8 years building production platforms in React, Angular and TypeScript. Led a team of 7 at Electrum. Hyderabad, India · Immediate joiner.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/img/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/img/favicon.ico" type="image/x-icon" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Seema Poonia" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Seema Poonia" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Fonts — async load to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Google Analytics 4 — replace G-XXXXXXXX with your measurement ID -->
    <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXX');
    </script> -->

    <!-- JSON-LD Person schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Seema Poonia",
        "jobTitle": "Senior Software Engineer & Team Lead",
        "url": "https://www.seemapoonia.me",
        "email": "seema.127poonia@gmail.com",
        "image": "https://www.seemapoonia.me/img/og-image.png",
        "nationality": "Indian",
        "description": "Senior Software Engineer and Team Lead with 8 years of experience architecting and building scalable web products from scratch using React and Angular. Focused on system design, technical leadership, and end-to-end delivery.",
        "worksFor": {
          "@type": "Organization",
          "name": "Electrum",
          "alternateName": "Pick My Solar India Pvt. Ltd."
        },
        "address": { "@type": "PostalAddress", "addressLocality": "Hyderabad", "addressCountry": "IN" },
        "knowsAbout": [
          "React", "Angular", "TypeScript", "JavaScript", "Node.js", "AWS Lambda",
          "System Design", "Frontend Architecture", "Technical Leadership",
          "Performance Optimization", "UI Development", "Team Leadership"
        ],
        "sameAs": [
          "https://github.com/127pooniapoonia",
          "https://www.linkedin.com/in/seema-poonia/"
        ]
      }
    </script>
  </head>

  <body class="font-sans text-gray-700 antialiased bg-white">
    <slot />

    <script>
      // Scroll reveal
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

      // Count-up numbers: <span data-count="45.7" data-decimals="1">
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const target = Number(el.dataset.count);
            const decimals = Number(el.dataset.decimals ?? 0);
            countObserver.unobserve(el);
            if (reduceMotion) {
              el.textContent = target.toFixed(decimals);
              return;
            }
            const start = performance.now();
            const duration = 1400;
            const tick = (now: number) => {
              const p = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = (target * eased).toFixed(decimals);
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('[data-count]').forEach((el) => countObserver.observe(el));
    </script>
  </body>
</html>
